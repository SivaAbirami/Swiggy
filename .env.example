# ==========================================
# Food Delivery Backend - Environment Configuration Example
# Copy this file to '.env' and populate with your actual environment values.
# ==========================================

# Active Profile (dev / prod / test)
SPRING_PROFILES_ACTIVE=dev

# Server Configuration
SERVER_PORT=8080

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=food_delivery_db
DB_USERNAME=food_user
DB_PASSWORD=food_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration (Introduced in Phase 2)
# JWT_SECRET=your-256-bit-secret-key-must-be-at-least-32-characters-long
# JWT_EXPIRATION_MS=86400000
